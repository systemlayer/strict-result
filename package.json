{
  "name": "strict-result",
  "version": "1.0.2",
  "type": "module",
  "description": "Handle success and failure explicitly with a type-safe, Rust-inspired Result for TypeScript.",
  "license": "MIT",
  "author": "systemlayer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemlayer/strict-result.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-transform-types --test"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
